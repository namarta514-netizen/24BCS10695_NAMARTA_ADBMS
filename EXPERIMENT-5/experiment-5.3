5.3(a):-
--- CONDITIONAL STATEMENT
--IF THEN

DO $$ 
    DECLARE 
	AGE INT:=18;
	VAL INT:=100;

	BEGIN 

	IF AGE>=18 THEN

	RAISE NOTICE 'YOUR AGE IS % AND YOU ARE ELIGIBLE TO VOTE TILL % YEARS',AGE,VAL;
	END IF;

	RAISE NOTICE 'YOU ARE INSIDE BEGIN END BLOCK';
	END;

	$$


5.3(b):-
--- CONDITIONAL STATEMENT
--  IF THEN ELSE

	DO $$
		DECLARE 
		AGE INT:=17;
		
		BEGIN

		IF AGE>=18 THEN

		RAISE NOTICE 'YOU AGE IS % AND YOU ARE ELIGIBLE TO VOTE',AGE;

		ELSE 
		RAISE NOTICE 'YOU AGE IS % AND YOU ARE NOT ELIGIBLE TO VOTE',AGE;
		END IF;

		RAISE NOTICE 'YOU ARE INSIDE BEGIN END BLOCK';
		END;

	$$


5.3(c):-
-- CONDITIONAL STATEMENT
--IF THEN ELSIF THEN ELSE

	DO $$

		DECLARE 
		VAL INT:=17;
		
		BEGIN

		IF VAL>=0 AND VAL<=10 THEN

		RAISE NOTICE ' VALUE IS % AND RANGE BETWEEN 1 TO 10 ',VAL;

		ELSIF VAL>10 AND VAL<=20 THEN
		RAISE NOTICE ' VALUE IS % AND RANGE BETWEEN 11 TO 20 ',VAL;
		
		ELSE 
        RAISE NOTICE ' VALUE IS % AND  VALUE IS GREATRE THAN 20',VAL;

		END IF;

		RAISE NOTICE 'YOU ARE INSIDE BEGIN END BLOCK';
		END;
$$
